# ==============================================================================
# Kerala Tourism Ecosystem (My Travelroad) — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. In DEVELOPMENT: Default values below allow the monorepo to start out of the box.
# 3. In PRODUCTION: Set NODE_ENV=production and provide cryptographically secure secrets.
#    The server will FAIL CLOSED and abort startup if any default dev keys are detected.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME (@kerala-tourism/server)
# ------------------------------------------------------------------------------
# Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Network port and host binding for the Express API server
PORT=5000
HOST=0.0.0.0

# Number of reverse proxies in front of Express (e.g. 1 for Cloudflare/ALB).
# In production, set to your proxy count (e.g. 1) to enable accurate client IP
# resolution for rate limiters.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. PRIMARY DATABASE — MONGODB ATLAS (@kerala-tourism/server)
# ------------------------------------------------------------------------------
# Standalone local instance (development) or MongoDB Atlas Replica Set (production).
# In production, a replica set with at least 3 nodes (M10+) is MANDATORY for ACID
# multi-document transactions in booking, inventory holds, and payments.
MONGO_URL=mongodb://127.0.0.1:27017/kerala_tourism
# Backward compatible alias supported by env loader:
MONGODB_URI=mongodb://127.0.0.1:27017/kerala_tourism

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED CACHE & RATE LIMITING — REDIS (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Optional in single-instance dev; required when scaling API servers horizontally.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=kt:
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. IDENTITY, JWT TOKENS & SECURITY (@kerala-tourism/server)
# ------------------------------------------------------------------------------
# JWT Access Secret: Minimum 32 characters.
# In PRODUCTION, generate via: openssl rand -base64 32
JWT_ACCESS_SECRET=kerala-tourism-dev-access-secret-32-chars-minimum

# JWT Access Token Expiry (e.g. '15m', '1h')
JWT_ACCESS_EXPIRES_IN=15m

# JWT Refresh Token Session Family Expiry in days
JWT_REFRESH_EXPIRES_IN_DAYS=7

# JWT Claims verification
JWT_ISSUER=kerala-tourism-auth
JWT_AUDIENCE=kerala-tourism-api

# Argon2id Server-Side Pepper (Optional additional secret mixed into password hashes)
# In PRODUCTION, generate via: openssl rand -base64 32
ARGON2_PEPPER=dev-argon2-pepper-key-32-chars-minimum!

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY — RAZORPAY SANDBOX / PRODUCTION
# ------------------------------------------------------------------------------
# In DEVELOPMENT/TEST: Use Razorpay test credentials. Do not use live keys.
# In PRODUCTION: Provide authoritative merchant credentials from Razorpay Dashboard.
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret_key_32chars
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder_32chars

# ------------------------------------------------------------------------------
# 6. PUSH NOTIFICATIONS — FIREBASE CLOUD MESSAGING (FCM)
# ------------------------------------------------------------------------------
# Set FIREBASE_SIMULATED=true in dev/test to mock push notification delivery.
# In PRODUCTION, set FIREBASE_SIMULATED=false and provide service account credentials.
FIREBASE_PROJECT_ID=kerala-tourism-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@kerala-tourism-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_SIMULATED=true

# ------------------------------------------------------------------------------
# 7. CORS ALLOWLIST & COOKIE CONFIGURATION
# ------------------------------------------------------------------------------
# Primary Frontend Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:3000

# Comma-separated list of allowed origins for browser web applications
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Backward compatible alias
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Cookie security settings
# In production, COOKIE_SECURE is automatically true when NODE_ENV=production.
COOKIE_DOMAIN=localhost
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY, MONITORING & ERROR TRACKING (SENTRY)
# ------------------------------------------------------------------------------
# Sentry DSN for backend error capture and performance APM
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.2

# ------------------------------------------------------------------------------
# 9. FRONTEND APPLICATIONS (apps/web, apps/admin, apps/business)
# ------------------------------------------------------------------------------
# Public API gateway URL exposed to browsers
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------------------------------
# 10. MOBILE APPLICATION (apps/mobile — React Native / Expo)
# ------------------------------------------------------------------------------
# Android Emulator uses 10.0.2.2 to access host loopback 127.0.0.1.
# iOS Simulator uses localhost or 127.0.0.1.
# Physical devices require the local LAN IP (e.g. http://192.168.1.50:5000/api/v1).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1
EXPO_PUBLIC_APP_ENV=development
